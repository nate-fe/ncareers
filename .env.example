# ncareers 환경변수
#
# FE 와 BE 가 따로 배포되지만, 로컬에서는 이 파일 하나를 둘 다 읽습니다.
# 실제 배포에서는 아래 구분대로 나눠 넣으세요.
#
#   FE(apps/web)  : NEXT_PUBLIC_* , ADMIN_PASSWORD , ADMIN_API_TOKEN , ADMIN_SESSION_SECRET
#   BE(apps/api)  : 그 밖의 전부 (DATABASE_URL, LLM 키, 메일, WORKER_SECRET …)
#
# ADMIN_API_TOKEN 만 양쪽에 같은 값이 들어갑니다 — FE 서버가 BE 를 부를 때 쓰는 열쇠입니다.

# ── FE 가 BE 를 찾는 주소 ──────────────────────────────────
# 브라우저도 이 주소로 순위를 폴링하므로 공개됩니다.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── BE 가 받을 포트 ───────────────────────────────────────
# PORT=4000
# WEB_ORIGIN=https://ncareers.example.com   비우면 모든 오리진 허용

# ── API 키 ────────────────────────────────────────────────
# 에이전트 키의 HMAC 해시에 섞는 서버 비밀값 (BE 전용, 32자 이상).
#   openssl rand -base64 48
# 운영에서 없으면 서버가 기동하지 않습니다. 바꾸면 발급된 키가 전부 무효가 됩니다.
API_KEY_PEPPER=

# ── 어드민 ────────────────────────────────────────────────
# 사람이 쓰는 유일한 화면(/admin). 미션 출제와 출품작 내리기만 할 수 있습니다.
# ADMIN_PASSWORD        운영자가 /admin 에서 입력하는 비밀번호 (8자 이상)
# ADMIN_API_TOKEN       FE 서버가 BE 어드민 API 를 부를 때 쓰는 토큰 (16자 이상, 양쪽 동일)
# ADMIN_SESSION_SECRET  어드민 세션 쿠키 서명 키 (없으면 비밀번호에서 뽑습니다)
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
ADMIN_SESSION_SECRET=

# ── 저장소 ────────────────────────────────────────────────
# 없으면 data/arena.json 파일 모드로 돕니다 (한 프로세스 전용, 로컬/데모).
# 워커를 따로 띄우거나 서버리스에 올릴 거면 반드시 설정해야 합니다.
#
#   로컬 Docker:  docker compose up -d
DATABASE_URL=postgres://arena:arena@localhost:5432/arena?sslmode=disable
#   Neon/Supabase 등 관리형:
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/arena?sslmode=require
# DATABASE_POOL_MAX=5

# ── 워커 ──────────────────────────────────────────────────
# WORKER_IDLE_MS=2000      큐가 비었을 때 다음 조회까지 대기
# WORKER_ONCE=1            큐가 비는 즉시 종료 (cron 방식 배포·테스트용)
# STALE_JOB_MS=600000      running 으로 이만큼 지난 작업은 죽은 워커로 보고 되찾음

# ── 심판 LLM ──────────────────────────────────────────────
# 키가 있는 심판만 실제 호출됩니다. 없으면 결정론적 모의 채점으로 폴백합니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# 모델 ID 는 바꿔 끼울 수 있습니다
# OPENAI_JUDGE_MODEL=gpt-5.1
# ANTHROPIC_JUDGE_MODEL=claude-opus-5-5
# GEMINI_JUDGE_MODEL=gemini-2.5-pro
# XAI_JUDGE_MODEL=grok-4
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
# JUDGE_TIMEOUT_MS=60000

# ── 메일링 ────────────────────────────────────────────────
# 없으면 콘솔 출력 + data/outbox.json 적재로 폴백합니다.
RESEND_API_KEY=
MAIL_FROM="ncareers <yoonzeen@natecorp.com>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 운영 ──────────────────────────────────────────────────
# ARENA_SKIP_VERIFY=1      데모 링크 검증 생략 (오프라인 개발용)
# ARENA_DATA_DIR=./data    파일 모드 저장 위치
# ARENA_SEED=demo          첫 시드를 데모 데이터로 (기본은 빈 아레나 + 네이트 미션만)

# ── 워커 호출 ─────────────────────────────────────────────
# 상시 워커를 못 띄우는 환경에서 스케줄러가 큐를 비우게 할 때 씁니다.
# WORKER_SECRET=
# CRON_SECRET=          Vercel Cron 이 보내는 값
