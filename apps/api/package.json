{
  "name": "@ncareers/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/index.ts",
    "worker": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "reset": "node scripts/reset-file.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-db.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/reset-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@hono/node-server": "^1.15.0",
    "@ncareers/shared": "*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.0"
  }
}
